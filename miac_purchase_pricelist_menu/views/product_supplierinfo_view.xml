<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="miac_view_product_supplierinfo_view_tree" model="ir.ui.view">
        <field name="name">product.supplierinfo.tree</field>
        <field name="model">product.supplierinfo</field>
        <field name="arch" type="xml">
            <list string="Suppliers Info">
                <field name="partner_id"/>
                <field name="product_tmpl_id"/>
                <field name="product_id" optional="show"/>
                <field name="price"/>
                <field name="currency_id"/>
                <field name="delay" optional="show"/>
                <field name="product_name" optional="hide"/>
                <field name="product_code" optional="hide"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
                <field name="min_qty" optional="hide"/>
                <field name="discount" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="product_supplierinfo_action" model="ir.actions.act_window">
        <field name="name">Suppliers Info</field>
        <field name="res_model">product.supplierinfo</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'visible_product_tmpl_id': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('miac_view_product_supplierinfo_view_tree'), 'sequence': 1}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('product.product_supplierinfo_form_view'), 'sequence': 2}),
            ]"/>
    </record>

    <menuitem action="product_supplierinfo_action"
              id="menu_product_supplierinfo_s"
              sequence="40"
              parent="purchase.menu_purchase_products"/>


</odoo>
