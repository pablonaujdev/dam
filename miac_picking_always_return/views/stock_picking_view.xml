<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_picking_view_form_inherit_always_return" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.always_return</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
          <xpath expr="//button[@name='%(stock.act_stock_return_picking)d']" position="attributes">
            <attribute name="invisible">state not in ('confirmed', 'waiting', 'assigned', 'done')</attribute>
          </xpath>
        </field>
    </record>

</odoo>
