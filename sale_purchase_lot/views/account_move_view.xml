<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_move_view_form_inherit_lot_id" model="ir.ui.view">
        <field name="name">account.move.form.inherit.lot.id</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='price_total']" position="after">
                <field name="sale_lot_id" optional="hide" column_invisible="True" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
