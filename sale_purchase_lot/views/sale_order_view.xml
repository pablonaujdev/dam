<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="sale_order_view_form_inherit_lot_id" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.lot.id</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='price_total']" position="after">
                <field name="lot_id" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//list" position="inside">
                <button name="link_to_machine" icon="fa-gear" type="object"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_view_form_inherit_lot_id" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.lot.id</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="lot_id"/>
            </xpath>
        </field>
    </record>

</odoo>
