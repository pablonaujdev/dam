<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="link_machine_wiz_view_form" model="ir.ui.view">
        <field name="name">link.machine.wiz.view.form</field>
        <field name="model">link.machine.wiz</field>
        <field name="arch" type="xml">
            <form string="Linker">
                <sheet>
                    <h1>
                        <field name="sale_line_id" nolabel="1" invisible="1"/>
                    </h1>
                    <group col="4">
                        <field name="is_new"/>
                        <field name="is_external"/>
                    </group>
                    <h1 invisible="is_new or is_external">Choose de product to link:</h1>
                    <field name="sale_linked_id" context="{'name_lot': True}" default_focus="1" nolabel="1"
                           style="border: 1px solid black;" invisible="is_new or is_external"/>
                    <h1 invisible="not is_new">Generate the lot to link:</h1>
                    <group invisible="not is_new">
                        <field name="lot_name"/>
                        <field name="product_id"/>
                    </group>
                    <h1 invisible="not is_external">Select the lot to link:</h1>
                    <group invisible="not is_external">
                        <field name="lot_id"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" default_focus="1" class="btn-primary" />
                    <button string="Cancel" special="cancel" type="object" class="btn btn-primary oe_inline"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

