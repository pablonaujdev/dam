<odoo>
    <record id="jh_fetchmail_receipt_tree" model="ir.ui.view">
        <field name="name">jh.fetchmail.receipt.tree</field>
        <field name="model">jh.fetchmail.receipt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="jh_state == 'failed'">
                <field name="jh_server_id"/>
                <field name="jh_folder"/>
                <field name="jh_uidvalidity"/>
                <field name="jh_uid"/>
                <field name="jh_state"/>
                <field name="jh_attempts"/>
                <field name="jh_next_attempt"/>
                <field name="jh_error" optional="show"/>
                <button name="action_jh_retry" type="object" string="Retry" groups="base.group_system" invisible="jh_state != 'failed'"/>
            </list>
        </field>
    </record>
    <record id="jh_fetchmail_receipt_action" model="ir.actions.act_window">
        <field name="name">IMAP collection receipts</field>
        <field name="res_model">jh.fetchmail.receipt</field>
        <field name="view_mode">list</field>
        <field name="domain">[('jh_server_id', '=', active_id)]</field>
    </record>
</odoo>
