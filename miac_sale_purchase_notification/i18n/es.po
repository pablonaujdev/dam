#. module: miac_sale_purchase_notification
#: model:mail.template,subject:miac_sale_purchase_notification.email_template_sale_purchase_license
msgid ""
"{{ object.company_id.name }}: Purchase License For {{ object.name }}"
msgstr ""
"{{ object.company_id.name }}: Compra de Licencias para {{ object.name }}"

#. module: miac_sale_purchase_notification
#: model:mail.template,body_html:miac_sale_purchase_notification.email_template_sale_purchase_license
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Dear <t t-if=\"object.company_id.notify_purchase_license_id\">\n"
"                        <span t-out=\"object.company_id.notify_purchase_license_id.name or ''\">\n"
"                        </span></t>\n"
"                        <br><br>\n"
"                        From the order  <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"></span>  has generated a purchase for licenses.\n"
"                        <br><br>\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                              <br><br>\n"
"                              <t t-out=\"object.user_id.signature or ''\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Hola <t t-if=\"object.company_id.notify_purchase_license_id\">\n"
"                        <span t-out=\"object.company_id.notify_purchase_license_id.name or ''\">\n"
"                        </span></t>\n"
"                        <br><br>\n"
"                        Para el pedido de venta  <span style=\"font-weight:bold;\" t-out=\"object.name or ''\"></span>  se ha generado una compra de licencias.\n"
"                        <br><br>\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                              <br><br>\n"
"                              <t t-out=\"object.user_id.signature or ''\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "

