#: model:ir.model,name:miac_sale_purchase_notification.model_sale_order
msgid "Sales Order"
msgstr "Pedidos de Venta"

#. module: miac_sale_purchase_notification
#: model:ir.model.fields,help:miac_sale_purchase_notification.field_res_company__notify_purchase_license_id
msgid "Receives the license purchase notice generated when confirming a sale.\nA single valid email is required; missing configuration does not block confirmation."
msgstr "Recibe el aviso de compra de licencias generado al confirmar una venta.\nRequiere un único correo válido; la falta de configuración no bloquea la confirmación."

#. module: miac_sale_purchase_notification
#: code:addons/miac_sale_purchase_notification/models/sale_order.py:0
msgid "License purchases were created. No notice was queued because the company notification recipient is missing or has no single valid email."
msgstr "Se han creado las compras de licencias. No se ha generado el aviso porque falta el destinatario de la compañía o no tiene un único correo válido."

#. module: miac_sale_purchase_notification
#: code:addons/miac_sale_purchase_notification/models/sale_order.py:0
msgid "License purchases were created. No notice was queued because the license purchase email template is missing."
msgstr "Se han creado las compras de licencias. No se ha generado el aviso porque falta la plantilla de correo de compra de licencias."

#. module: miac_sale_purchase_notification
#: code:addons/miac_sale_purchase_notification/models/sale_order.py:0
msgid "License purchases were created, but their email notice could not be generated. The sale and purchases are preserved; please contact an administrator."
msgstr "Se han creado las compras de licencias, pero no se ha podido generar el aviso. La venta y las compras se conservan; contacte con un administrador."
