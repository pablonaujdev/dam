<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="account_move_view_form_inherit_notes_print" model="ir.ui.view">
        <field name="name">account.move.form.inherit.notes.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <label for="ref" position="before">
                <field name="client_ref" invisible="move_type not in ['out_invoice','out_refund','in_invoice','in_refund']"/>
                <field name="supplier_ref" invisible="move_type not in ['out_invoice','out_refund','in_invoice','in_refund']"/>
            </label>
        </field>
    </record>

</odoo>
