<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_picking_view_form_inherit_notes_print" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.notes.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <field name="location_id" position="before">
                <field name="client_ref"/>
                <field name="supplier_ref"/>
            </field>
            <xpath expr="//notebook" position="inside">
                <page string="Note to print" name="note_print">
                    <field name="notes_print" string="Note" placeholder="Terms and condition"/>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
