<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Herencia de la vista de propiedades contables del contacto -->
        <record id="res_partner_property_form_inherit_jh_taxes" model="ir.ui.view">
            <field name="name">res.partner.property.form.inherit.jh.taxes</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="mode">extension</field>
            <field name="priority">2</field>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='property_account_position_id']" position="after">
                    <field name="jh_taxes_id" widget="many2many_tags"/>
                    <field name="jh_purchase_taxes_id" widget="many2many_tags"/>
                </xpath>

            </field>
        </record>

        <record id="res_partner_inherit_stock_picking" model="ir.ui.view">
            <field name="name">res.partner.inherit.stock.picking</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="action_view_stock_pickings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        groups="stock.group_stock_user">
                        <field
                            name="jh_stock_picking_count"
                            widget="statinfo"
                            string="Movimientos"/>
                    </button>
                </xpath>

            </field>
        </record>

        <record id="jh_res_partner_delivery_subscription_form" model="ir.ui.view">
            <field name="name">res.partner.delivery.subscription.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_jh_delivery_subscriptions" type="object"
                            class="oe_stat_button" icon="fa-refresh"
                            groups="sales_team.group_sale_salesman"
                            invisible="type != 'delivery' or jh_delivery_subscription_count == 0">
                        <field name="jh_delivery_subscription_count" widget="statinfo"
                               string="Suscripciones en esta dirección"/>
                    </button>
                </xpath>
                <xpath expr="//field[@name='child_ids']/kanban/field[@name='type']" position="after">
                    <field name="jh_delivery_subscription_count"/>
                </xpath>
                <xpath expr="//field[@name='child_ids']/kanban/templates/t[@t-name='card']/main" position="inside">
                    <a t-if="record.type.raw_value == 'delivery' and record.jh_delivery_subscription_count.raw_value"
                       type="object" name="action_view_jh_delivery_subscriptions"
                       groups="sales_team.group_sale_salesman" href="#"
                       class="oe_kanban_action oe_kanban_action_a me-1"
                       title="Suscripciones activas en esta dirección">
                        <span class="badge rounded-pill">
                            <i class="fa fa-fw fa-refresh" role="img" aria-label="Suscripciones activas"/>
                            <t t-out="record.jh_delivery_subscription_count.value"/>
                        </span>
                    </a>
                </xpath>
            </field>
        </record>

        <record id="jh_res_partner_delivery_subscription_kanban" model="ir.ui.view">
            <field name="name">res.partner.delivery.subscription.kanban</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="inside">
                    <field name="type"/>
                    <field name="jh_delivery_subscription_count"/>
                </xpath>
                <xpath expr="//templates/t[@t-name='card']/main" position="inside">
                    <a t-if="record.type.raw_value == 'delivery' and record.jh_delivery_subscription_count.raw_value"
                       type="object" name="action_view_jh_delivery_subscriptions"
                       groups="sales_team.group_sale_salesman" href="#"
                       class="oe_kanban_action oe_kanban_action_a me-1"
                       title="Suscripciones activas en esta dirección">
                        <span class="badge rounded-pill">
                            <i class="fa fa-fw fa-refresh" role="img" aria-label="Suscripciones activas"/>
                            <t t-out="record.jh_delivery_subscription_count.value"/>
                        </span>
                    </a>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
