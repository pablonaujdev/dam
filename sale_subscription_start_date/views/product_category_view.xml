<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_category_view_form_inherit_days_to_activate" model="ir.ui.view">
        <field name="name">product.category.form.inherit.days.to.activate</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <group name="first" position="after">
                <group>
                    <group name="Subscriptions" string="Subscriptions">
                        <field name="days_to_activate"/>
                    </group>
                </group>
            </group>
        </field>
    </record>

</odoo>
