<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="sale_order_view_form_inherit_days_to_activate" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.days.to.activate</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='subscription_info']/field[@name='start_date']" position="attributes">
                <attribute name="string">Active Date</attribute>
            </xpath>
        </field>
    </record>

</odoo>
