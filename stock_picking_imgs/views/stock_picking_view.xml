<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="stock_picking_image_form_view" model="ir.ui.view">
        <field name="name">stock.picking.image.form.view</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="model">stock.picking</field>
        <field type="xml" name="arch">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="before">
                <field name="image" widget="image" readonly="1" options="{'size': [48, 48]}"/>
            </xpath>
        </field>
    </record>

</odoo>
