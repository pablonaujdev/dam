<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_delivery_image_document" inherit_id="stock.report_delivery_document">
            <xpath expr="//table[@name='stock_move_table']//th[@name='th_sm_product']" position="before">
                <th name="th_sm_image"><strong>Image</strong></th>
            </xpath>
            <xpath expr="//table[@name='stock_move_table']//td[span[@t-field='move.product_id']]" position="before">
                <td name="td_image" class="text-center align-middle">
                    <t t-if="move.image">
                        <img t-att-src="image_data_uri(move.image)" style="max-height:80pt; max-width:80pt;" alt="Product image"/>
                    </t>
                </td>
            </xpath>
        </template>

    </data>
</odoo>
