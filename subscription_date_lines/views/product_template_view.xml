<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_default_plan_view_form_inherit" model="ir.ui.view">
        <field name="name">product.template.default.plan.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="sale_subscription.product_template_only_view_form_recurring" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='subscription_pricing']//field[@name='allow_one_time_sale']" position="before">
                <field name="subscription_plan_default"/>
            </xpath>
        </field>
    </record>

</odoo>
