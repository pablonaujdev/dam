<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_cancel_wiz_view_form" model="ir.ui.view">
        <field name="name">sale.order.cancel.wiz.view.form</field>
        <field name="model">sale.order.cancel.wiz</field>
        <field name="arch" type="xml">
            <form string="Reason Cancelation">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Accept" name="accept_reason" type="object"
                        default_focus="1" class="btn-primary" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>
