<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_company_view_form_inherit_renovation_months" model="ir.ui.view">
        <field name="name">res.company.form.inherit.renovation.months</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Subscriptions" name="subscriptions_info">
                    <group>
                        <field name="months_renovation"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
